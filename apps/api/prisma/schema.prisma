// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleType {
  glc
  lnl
  sermon
}

enum ArticleStatus {
  draft
  unpublish
  published
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

/// Opaque login token. Only the SHA-256 hash is stored. `expiresAt` is 24 hours after login.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// A named collection of articles. The cover lives in Cloudflare R2; `imageKey` is the object key.
model Series {
  id        String    @id @default(cuid())
  title     String    @unique
  imageKey  String?
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("series")
}

/// Teaching content. `imageKey` and `fileKey` are Cloudflare R2 object keys, not public URLs.
model Article {
  id            String        @id @default(cuid())
  title         String
  subtitle      String        @default("")
  body          String        @default("")
  verse         String
  uploadedAt    DateTime      @default(now())
  sermonDate    DateTime?
  tags          String[]      @default([])
  type          ArticleType
  articleStatus ArticleStatus @default(draft)
  imageKey      String?
  fileKey       String?
  videoLink     String?
  audioLink     String?
  seriesId      String?
  series        Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([uploadedAt])
  @@map("articles")
}

/// Site-wide editable copy shown on the public website.
model Content {
  id           String   @id @default("site")
  latestSermon String   @default("")
  updatedAt    DateTime @updatedAt

  @@map("content")
}

enum Gender {
  male
  female
}

enum CivilStatus {
  single
  married
  widowed
  separated
}

enum Weekday {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

/// Named assignment such as Member. The default "Member" row is seeded, not a column default.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  members     Member[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

/// A church location. `name` is the church; `branch` is the location name.
model ChurchBranch {
  id        String   @id @default(cuid())
  name      String
  branch    String
  address   String
  members   Member[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branch])
  @@map("church_branches")
}

/// Recurring small-group meeting. `time` is a clock label such as "19:00".
model DgroupMeeting {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  days        Weekday[]
  time        String
  members     Member[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("dgroup_meetings")
}

/// Directory person. Roles are optional; an empty list means no role is connected yet.
model Member {
  id             String          @id @default(cuid())
  /// Formal ID assigned at registration: TNC-00001-26. The number increments for each member; the year is the registration year.
  membershipId   String          @unique @default(dbgenerated("tnc_membership_id()"))
  firstName      String
  lastName       String
  mobileNumber   String
  email          String?
  messengerName  String?
  birthdate      DateTime        @db.Date
  gender         Gender
  civilStatus    CivilStatus
  roles          Role[]
  branchId       String
  branch         ChurchBranch    @relation(fields: [branchId], references: [id])
  isDgroupLeader Boolean         @default(false)
  dgroupMeetings DgroupMeeting[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId])
  @@map("members")
}
